# ============================================================
# Spontus Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must not be committed.
# ============================================================

# Application URL used by Next.js for absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=your-url-here

# Supabase anonymous public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-key-here

# Platform admins (comma-separated personal/work emails). Server-only — not exposed to the browser.
# Users must sign in with one of these emails to see Admin in nav or open /admin/*.
ADMIN_EMAILS=you@example.com

# Instagram live follower counts via the Graph API "Business Discovery" endpoint.
# Both must be set to enable live counts; otherwise the UI uses cached/seeded numbers.
# Server-only — never exposed to the browser. Note: the target accounts must be
# Instagram Business/Creator profiles for Business Discovery to return their data.
INSTAGRAM_GRAPH_TOKEN=your-long-lived-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-business-account-id
